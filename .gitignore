# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# Python & Backend (backend/)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.env
.pytest_cache/
.coverage
htmlcov/
.tox/

# ==========================================
# Frontend & Node.js (frontend/ & root)
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Docker & ClickHouse / Databases
# ==========================================
# Exclude mounted database data directories/volumes
clickhouse_data/
clickhouse_logs/
postgres_data/
*.db
*.sqlite3

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# Temporary Files & Local Data
# ==========================================
*.tmp
*.temp
# Exclude local raw CSV/data files if they contain dummy or heavy testing data
data/
*.csv